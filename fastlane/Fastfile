require 'dotenv'
Dotenv.load

default_platform(:android)

# Shared build number so Android and iOS stay consistent
def build_number
  @build_number ||= Time.now.to_i
end

def prepare_build_dirs
  sh "mkdir -p build/android"
  sh "mkdir -p build/ios"
end

platform :android do
  desc "Build Android and upload to Play Closed Testing"
  lane :ci_android do
    prepare_build_dirs

    gradle(
      task: "clean",
      project_dir: "android"
    )

    gradle(
      task: "bundleRelease",
      project_dir: "android",
      properties: {
        "android.injected.version.code" => build_number
      }
    )

    supply(
      track: "alpha",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build iOS and upload to App Store Connect"
  lane :ci_ios do
    prepare_build_dirs

    match(
      type: "appstore",
      clone_branch_directly: true
    )

    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/Yuzic.xcodeproj"
    )

    build_settings = sh(
      "xcodebuild -workspace ios/Yuzic.xcworkspace -scheme Yuzic -configuration Release -showBuildSettings",
      log: false
    )
    signing_lines = build_settings
      .lines
      .select do |line|
        line.match?(
          /\b(PRODUCT_BUNDLE_IDENTIFIER|DEVELOPMENT_TEAM|CODE_SIGN_STYLE|CODE_SIGN_IDENTITY|PROVISIONING_PROFILE_SPECIFIER|EXPANDED_CODE_SIGN_IDENTITY_NAME)\b/
        )
      end
    UI.important("Release signing diagnostics:\n#{signing_lines.join}")

    build_app(
      scheme: "Yuzic",
      workspace: "ios/Yuzic.xcworkspace",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "Yuzic.ipa",
      include_symbols: false,
      include_bitcode: false
    )

    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end
end