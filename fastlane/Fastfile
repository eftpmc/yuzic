require 'dotenv'
Dotenv.load

default_platform(:android)

# Version codes and build numbers are asked of the stores, never derived.
#
# They used to be GITHUB_RUN_NUMBER plus a fixed offset, documented as "a
# per-workflow-file counter that never resets or repeats". That is true of a
# workflow_dispatch and false of a workflow_call: a reusable workflow sees the
# *caller's* run number, so one build entered two ways kept two unrelated
# counters. The dispatch path reached versionCode 132 while the release path
# was still at 118, and Play refused 2.0.0 with "You cannot rollout this
# release because it does not allow any existing users to upgrade to the newly
# added APKs" — after a fully green Gradle build.
#
# Play and App Store Connect both require a number greater than what they
# already hold, which makes them the only things that know the answer. Asking
# them makes every entry point agree by construction. There is deliberately no
# override and no fallback: a number nobody checked is the failure being
# replaced here, and version code space spent is not recoverable.

APP_IDENTIFIER = "com.arinora.rawarr"

# Every track, not only the one being uploaded to. A code live anywhere is a
# code Play will not take again, and production sits below alpha here.
PLAY_TRACKS = %w[internal alpha beta production].freeze

def resolved_android_version_code
  codes = PLAY_TRACKS.flat_map do |track|
    begin
      google_play_track_version_codes(
        package_name: APP_IDENTIFIER,
        track: track,
        json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"]
      ).map(&:to_i)
    rescue StandardError => e
      # A track that has never been used has nothing to report, which is not
      # a failure — only every track being unreadable is.
      UI.important("No version codes readable on '#{track}' (#{e.message.to_s.strip.lines.first.to_s.strip}) — skipping it.")
      []
    end
  end

  if codes.empty?
    UI.user_error!(
      "Play returned no version codes on any of: #{PLAY_TRACKS.join(', ')}. " \
      "Refusing to invent one. Check GOOGLE_PLAY_JSON_KEY and that the package " \
      "is still #{APP_IDENTIFIER}."
    )
  end

  highest = codes.max
  code = highest + 1
  UI.important("Highest version code on Play: #{highest}. Using Android version code: #{code}")
  code
end

def resolved_version_label
  raw = ENV["VERSION_LABEL"]&.strip
  value = raw.nil? || raw.empty? ? "1.1.17" : raw

  unless value.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!("Invalid version label '#{value}'. Use semantic format like 1.1.17.")
  end

  UI.important("Using version label: #{value}")
  value
end

def resolved_ios_build_number(api_key, _version_label)
  # Every build the app has, and the highest number among them — not the
  # "latest" one.
  #
  # `latest_testflight_build_number` cannot answer this, and using it here was
  # a real mistake rather than a subtlety: it asks App Store Connect for
  # `sort: "-uploadedDate", limit: 1`, so it returns the most recently
  # *uploaded* build. When 2.0.0 (10) was uploaded after 2.0.0 (94), "latest"
  # was 10, this produced 11, and the new build sorted below five older ones in
  # TestFlight. The two-counter bug was fixed and the number still did not
  # climb.
  #
  # Asked across every version rather than the current train. App Store Connect
  # only requires uniqueness within a train, but a number that also climbs
  # app-wide is what puts a new build at the top of the tester's list, which is
  # the thing anyone actually wants from it.
  require 'spaceship'

  token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  UI.user_error!("No App Store Connect API token — cannot ask for a build number.") if token.nil?
  Spaceship::ConnectAPI.token = token

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("No app on App Store Connect for #{APP_IDENTIFIER}.") if app.nil?

  # AWAITING_UPLOAD is excluded because those carry no uploaded date and are
  # not builds anyone has; the other three states all hold a number that is
  # spent and cannot be reused.
  uploads = Spaceship::ConnectAPI.get_build_uploads(
    app_id: app.id,
    filter: { state: "PROCESSING,FAILED,COMPLETE" },
    sort: "-uploadedDate",
    limit: 200
  )

  numbers = uploads.map { |upload| upload.cf_build_version.to_i }.reject(&:zero?)
  if numbers.empty?
    UI.user_error!(
      "App Store Connect returned no builds for #{APP_IDENTIFIER}. Refusing to " \
      "invent a build number — check the API key's access."
    )
  end

  highest = numbers.max
  value = highest + 1
  UI.important(
    "App Store Connect holds #{numbers.count} builds (capped at 200 by recency); " \
    "highest build number: #{highest}. Using iOS build number: #{value}"
  )
  value
end

def resolved_ios_team_id
  ENV["IOS_TEAM_ID"] || "Y6YJ4P25H9"
end

def resolved_ios_profile_name
  raw = ENV["IOS_PROFILE_NAME"]&.strip
  raw.nil? || raw.empty? ? "carplay" : raw
end

def prepare_build_dirs
  sh "mkdir -p build/android"
  sh "mkdir -p build/ios"
end

platform :android do
  desc "Build Android and upload to Play Closed Testing"
  lane :ci_android do
    prepare_build_dirs

    gradle(
      tasks: ["clean", "assembleRelease", "bundleRelease"],
      project_dir: "android",
      flags: "--no-daemon",
      properties: {
        "android.injected.version.code" => resolved_android_version_code,
        "android.injected.version.name" => resolved_version_label
      }
    )

    supply(
      track: "alpha",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      # Screenshots are generated by tools/store-screenshots/capture.sh and
      # copied into metadata/android/en-US/images by its publish.py. Play caps
      # each device type at 8, so that directory must hold only the current
      # set — a stale extra file is an upload failure, not an extra listing
      # image.
      skip_upload_images: false,
      skip_upload_screenshots: false,
      # Explicitly not skipped. Notes come from
      # metadata/android/en-US/changelogs/default.txt, which supply falls back
      # to when there is no <version code>.txt — and there cannot be one, since
      # the code is only known once Play has been asked. Every upload before
      # this logged "Could not find changelog" and shipped with no notes.
      skip_upload_changelogs: false
    )
  end
end

platform :ios do
  desc "Build iOS and upload to App Store Connect"
  lane :ci_ios do
    prepare_build_dirs

    team_id = resolved_ios_team_id
    version_label = resolved_version_label
    profile_name = resolved_ios_profile_name

    UI.important("iOS team id: #{team_id}")
    UI.important("iOS version label: #{version_label}")
    UI.important("iOS provisioning profile: #{profile_name}")

    setup_ci(
      keychain_name: "build.keychain",
      timeout: 21600
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_API_KEY_BASE64"],
      is_key_content_base64: true
    )

    # After the API key exists, because the number is asked of App Store
    # Connect rather than derived from anything local.
    build_number = resolved_ios_build_number(api_key, version_label)

    match(
      type: "appstore",
      app_identifier: "com.arinora.rawarr",
      team_id: team_id,
      api_key: api_key,
      readonly: true,
      keychain_name: "build.keychain"
    )

    increment_version_number(
      version_number: version_label,
      xcodeproj: "ios/Yuzic.xcodeproj"
    )

    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/Yuzic.xcodeproj"
    )

    build_app(
      scheme: "Yuzic",
      workspace: "ios/Yuzic.xcworkspace",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version_label}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.arinora.rawarr" => profile_name
        }
      },
      output_directory: "build/ios",
      output_name: "Yuzic.ipa",
      include_symbols: false,
      include_bitcode: false
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      # Screenshots come from tools/store-screenshots (capture.sh, then
      # publish.py) and land in fastlane/screenshots/en-US. deliver picks the
      # device from the filename prefix, so those names are load-bearing.
      #
      # App Store Connect accepts only exact sizes and rejects the upload
      # otherwise — after the whole build has run. compose.py exports at the
      # store size for that reason (the iPad artboard is 2064x2752 while the
      # store wants 2048x2732), and publish.py asserts it before copying.
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end
