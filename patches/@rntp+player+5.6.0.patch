-        jsonToBundle(rntp.getJSONObject(KEY_EXTRAS)),
-      )
-    }
-
-    metaBuilder.setExtras(metadataExtras)
-    return item.buildUpon().setMediaMetadata(metaBuilder.build()).build()
-  }
